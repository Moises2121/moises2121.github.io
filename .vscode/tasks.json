{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll Preview",
      "type": "shell",
      "command": "docker-compose up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Stop Preview",
      "type": "shell",
      "command": "docker-compose down"
    }
  ]
}
